APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# Database
DB_USER=mailgo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Mailcow
MAILCOW_API_URL=http://nginx:8083/api/v1
MAILCOW_API_KEY=CHANGE_ME_AFTER_MAILCOW_SETUP
MAIL_SERVER_HOSTNAME=mail.yourdomain.com

# IMAP (Mailcow Dovecot — internal Docker network)
IMAP_HOST=dovecot
IMAP_PORT=993
IMAP_TLS=true

# Brevo
BREVO_API_KEY=xkeysib-CHANGE_ME
BREVO_API_URL=https://api.brevo.com/v3
BREVO_FROM_EMAIL=info@yerevan.digital
BREVO_FROM_NAME=MailGo

# Frontend
NEXT_PUBLIC_API_URL=https://bizmail.tracix.net/api/v1

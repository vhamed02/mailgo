# Application Configuration
APP_ENV=development
APP_NAME=MailGo
APP_PORT=8080
APP_WORKERS=4
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Database Configuration
DATABASE_URL=postgresql://mailgo:mailgo_password@postgres:5432/mailgo?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE=5
DATABASE_MAX_LIFETIME=5m

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=mailgo

# Mailcow Configuration (Infrastructure - Internal Only)
MAILCOW_API_URL=http://mailcow-dockerized-mailcow-1:8080/api/v1
MAILCOW_API_KEY=your-mailcow-api-key-here
MAIL_SERVER_HOSTNAME=mail.yourdomain.com
MAILCOW_TIMEOUT=30s

# Brevo Configuration (Infrastructure - Outbound Email)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_API_URL=https://api.brevo.com/v3
BREVO_TIMEOUT=30s
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=MailGo

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_ENABLED=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Metrics & Observability
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_ENDPOINT=

# Multi-Tenant Quotas (Default)
DEFAULT_MAX_DOMAINS=5
DEFAULT_MAX_MAILBOXES=50
DEFAULT_MAX_STORAGE_GB=10
DEFAULT_MAX_ALIASES=100

# Security
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT=24h

# Async Worker Configuration
ASYNQ_CONCURRENCY=10
ASYNQ_QUEUE_CRITICAL_PRIORITY=3
ASYNQ_QUEUE_DEFAULT_PRIORITY=2
ASYNQ_QUEUE_LOW_PRIORITY=1

# Health Check
HEALTH_CHECK_INTERVAL=30s
